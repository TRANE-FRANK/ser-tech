---
import { Image } from "astro:assets";
import logo from "../assets/images/logo.avif";
---

<header
  class="sticky top-0 z-50 backdrop-blur bg-bg-main/70 border-b border-slate-800"
>
  <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
    <a href="/" class="flex items-center gap-3">
      <Image
        src={logo}
        alt="SerTech logo"
        width={48}
        height={48}
        class="rounded-md"
        loading="eager"
      />

      <span class="font-bold text-lg">
        <span class="text-primary">Ser</span>Tech
      </span>
    </a>

    <nav class="hidden md:flex gap-6 text-sm text-text-secondary">
      <a href="#servicios" class="hover:text-white">Servicios</a>
      <a href="#proceso" class="hover:text-white">Proceso</a>
      <a href="#contacto" class="hover:text-white">Contacto</a>
    </nav>

    <!-- CTA -->
    <a href="#contacto" class="btn-primary hidden md:block">
      Diagnóstico gratis
    </a>
  </div>
</header>

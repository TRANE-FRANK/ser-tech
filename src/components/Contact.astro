---
const phone = "5212211394316";
---

<section id="contacto" class="bg-bg-main py-24 reveal reveal-scale">
  <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-center">
    <!-- 🧠 Info -->
    <div class="space-y-6">
      <h2 class="text-3xl md:text-4xl font-bold">¡Hablemos de tu proyecto!</h2>

      <p class="text-text-secondary text-lg">
        Cuéntanos qué necesitas y te ayudamos a encontrar la mejor solución para
        tu negocio.
      </p>

      <!-- confianza -->
      <div class="space-y-2 text-text-secondary">
        <p>📧 sertech.puebla@ser-tech.com.mx</p>
        <p>📍 Puebla, México</p>
        <p>⏱ Respuesta en menos de 24 horas</p>
      </div>
    </div>

    <!-- 🧱 Formulario visual -->
    <div class="bg-bg-card p-8 rounded-2xl border border-slate-800 shadow-lg">
      <form
        onsubmit={`event.preventDefault();
        const name = this.name.value;
        const email = this.email.value;
        const msg = this.message.value;

        const text = encodeURIComponent(
          'Hola, soy ' + name + '. ' + msg + ' (Correo: ' + email + ')'
        );

        window.open('https://wa.me/${phone}?text=' + text, '_blank');
        `}
        class="space-y-5"
      >
        <input
          type="text"
          name="name"
          placeholder="Nombre"
          required
          class="w-full p-3 rounded-lg bg-bg-secondary border border-slate-700 focus:outline-none focus:border-primary"
        />

        <input
          type="email"
          name="email"
          placeholder="Correo"
          required
          class="w-full p-3 rounded-lg bg-bg-secondary border border-slate-700 focus:outline-none focus:border-primary"
        />

        <textarea
          name="message"
          rows="4"
          placeholder="¿Qué necesitas?"
          required
          class="w-full p-3 rounded-lg bg-bg-secondary border border-slate-700 focus:outline-none focus:border-primary"
        ></textarea>

        <button
          type="submit"
          class="w-full bg-secondary hover:opacity-90 py-3 rounded-xl font-semibold"
        >
          💬 Enviar por WhatsApp
        </button>
      </form>
    </div>
  </div>
</section>
